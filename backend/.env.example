# Local MongoDB, or replace with an Atlas mongodb+srv connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=pcosense

# Maximum attempts per IP and authentication route in each 15-minute window.
AUTH_RATE_LIMIT=20

# Ingredient scanner runs inside account_api on the same Render service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Legacy, separate graph/dataset food services only (not needed for the scanner).
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ollama local model for ingredient extraction (e.g., llama3.2, llama3, or adrienbrault/nous-hermes2pro:Q8_0)
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional absolute path to an existing ChromaDB dataset.
# CHROMA_DB_PATH=E:/path/to/chroma_data
CHROMA_COLLECTION=cooked_dishes

# Optional password recovery. The provider must support TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
